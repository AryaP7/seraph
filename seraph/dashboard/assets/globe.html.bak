  grid: "<rect x=\"3.6\" y=\"3.6\" width=\"6.6\" height=\"6.6\" fill=\"none\"/><rect x=\"13.8\" y=\"3.6\" width=\"6.6\" height=\"6.6\" fill=\"none\"/><rect x=\"3.6\" y=\"13.8\" width=\"6.6\" height=\"6.6\" fill=\"none\"/><rect x=\"13.8\" y=\"13.8\" width=\"6.6\" height=\"6.6\" fill=\"none\"/>",
