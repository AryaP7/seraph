};
function ic(name, size, cls){
  var b = ICONS[name];
  if(!b) return "";
  var px = size || 14;
  return '<svg class="ic '+(cls||"")+'" viewBox="0 0 24 24" width="'+px+'" height="'+px+
         '" fill="currentColor" stroke="currentColor" stroke-width="1.7" '+
         'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">'+b+'</svg>';
}
var SECTOR_ICON = {
  "Steel":"steel", "Solar":"solar", "Auto Components":"auto", "Auto":"auto",
  "Pharma":"pharma", "Port":"port", "Policy":"policy",
  "Banking":"policy", "IT Services":"grid", "FMCG":"grid", "Energy":"wave"
};

/* ===================== chrome ===================== */
function el(id){return document.getElementById(id)}
function sparkSVG(d,c){
  var w=100,h=26,p=d.map(function(v,i){return (i/(d.length-1))*w+","+(h-v*h*0.92-1)}).join(" ");
  return '<svg class="spark" viewBox="0 0 '+w+' '+h+'" preserveAspectRatio="none" style="width:100%">'+
         '<polyline points="'+p+'" fill="none" stroke="'+c+'" stroke-width="1.6" '+
         'stroke-linecap="round" stroke-linejoin="round"/></svg>';
}

el("ticker").innerHTML = TICKER.map(function(t){
  var cls = t[2]>=0?"up":"dn", ar = ic(t[2]>=0?"up":"down", 9);
  return '<span><b>'+t[0]+'</b>'+t[1]+' <span class="'+cls+'">'+ic(t[2]>=0?"up":"down",9)+' '+Math.abs(t[2]).toFixed(2)+'%</span></span>';
}).join("");

el("commod").innerHTML = COMMOD.map(function(c){
  var cls=c[2]>=0?"up":"dn";
  return '<tr><td style="color:var(--dim)">'+c[0]+'</td><td>'+c[1]+
         '</td><td class="'+cls+'">'+(c[2]>=0?"+":"")+c[2].toFixed(1)+'%</td></tr>';
}).join("");

el("signals").innerHTML = SIGNALS.map(function(s){
  return '<div class="sig" data-focus="'+s[0]+'"><div class="loc">'+s[0]+'</div>'+
         '<div class="t">'+s[1]+'</div><div class="m"><span class="sev '+s[4]+'">'+
         (s[4]==="cr"?"CRITICAL":"WATCH")+'</span><span>'+s[2]+'</span><span>· '+s[3]+'</span></div></div>';
}).join("");

el("stress").innerHTML = SECTORS.map(function(s,i){
  var amber = s.s==="amber";
  return '<div class="srow" data-sector="'+s.n+'" title="Show '+s.n+' exposure on the globe"><div class="top">'+
    '<span class="cc">'+String(i+1).padStart(2,"0")+'</span>'+
    '<span class="sicon">'+ic(SECTOR_ICON[s.n]||"grid",14)+'</span>'+
    '<span class="nm">'+s.n+'</span>'+
    '<span class="bd '+(amber?"amber":"safe")+'">'+(amber?"AMBER":"CLEAR")+'</span></div>'+
    '<div class="sub"><span class="rep">'+s.rep+' signals · n(S) '+s.r.toFixed(2)+
    '</span><span class="chg '+(s.chg.indexOf("-")===0?"dn":"up")+'">'+s.chg+'</span></div>'+
    sparkSVG(s.sp, amber?"#f59e0b":"#3f4b59")+'</div>';
}).join("");

el("exposure").innerHTML = EXPOSURE.map(function(e){
  return '<div class="exp"><div class="l"><span style="color:'+(e[2]?"var(--amber)":"var(--dim)")+'">'+
    e[0]+'</span><span style="color:var(--dim)">'+e[1]+'%</span></div>'+
    '<div class="bar"><i style="width:'+(e[1]*3.4)+'%;background:'+(e[2]?"var(--amber)":"#3d4956")+'"></i></div></div>';
}).join("") + '<div style="font-size:10.5px;color:var(--dim2);line-height:1.5;margin-top:4px">'+
  '29% of holdings sit in currently-amber sectors. Market-wide CSRS (0.21, GREEN) does not reflect this concentration.</div>';

el("met").innerHTML = MET.map(function(m){
  return '<div class="met"><div class="k"><b>'+m[0]+'</b><i class="'+m[2]+'">'+m[1]+'</i></div>'+
         '<div class="ch">'+m[3]+'</div></div>';
}).join("") + '<div style="margin-top:8px;font-size:10px;color:var(--dim2);line-height:1.5">'+
  '<span class="adv">NOT IN CSRS v3</span> These are context, not model inputs. CSRS reads price and '+
  'jump data only; nothing below feeds the Hawkes, RMT or regime layers.</div>';


var AD = {"assets":[{"id":"rourkela","name":"Rourkela Steel Plant","op":"SAIL","sector":"Steel","state":"Odisha","lon":84.85,"lat":22.26,"cap":"4.5 Mtpa crude steel","status":"critical","weight":0.92,"note":"Flat products line most exposed to the EU anti-dumping duty on HRC.","policy":"EU AD proceeding AD-712 \u00b7 provisional duty 12-18% indicated"},{"id":"kalinganagar","name":"Kalinganagar Works","op":"Tata Steel","sector":"Steel","state":"Odisha","lon":86.05,"lat":20.93,"cap":"8.0 Mtpa","status":"critical","weight":0.88,"note":"Export-heavy slab and HRC mix; Paradip dispatch dependent.","policy":"Draft flat-steel export duty \u00b7 15% under inter-ministerial review"},{"id":"angul","name":"Angul Steel","op":"Jindal Steel","sector":"Steel","state":"Odisha","lon":85.1,"lat":20.84,"cap":"6.0 Mtpa","status":"amber","weight":0.71,"note":"Coal-gasification route; input cost pass-through limited.","policy":"Coking coal import parity \u00b7 watch"},{"id":"paradip","name":"Paradip Port","op":"PPT","sector":"Steel","state":"Odisha","lon":86.67,"lat":20.26,"cap":"145 Mtpa throughput","status":"amber","weight":0.66,"note":"Single dispatch chokepoint for Odisha steel exports.","policy":"Cyclone advisory \u00b7 Bay of Bengal depression"},{"id":"charanka","name":"Charanka Solar Park","op":"GSECL","sector":"Solar","state":"Gujarat","lon":71.19,"lat":23.9,"cap":"790 MW","status":"critical","weight":0.95,"note":"Module replacement cycle exposed to safeguard duty band widening.","policy":"US Section 301 review \u00b7 PV cell imports \u00b7 USTR docket open"},{"id":"dholera","name":"Dholera Solar Park","op":"GPCL","sector":"Solar","state":"Gujarat","lon":72.19,"lat":22.25,"cap":"4,750 MW planned","status":"critical","weight":0.9,"note":"Largest planned build; capex sensitive to cell price and ALMM.","policy":"ALMM List-II enforcement + safeguard duty revision"},{"id":"mundra","name":"Mundra Cell & Module","op":"Adani Solar","sector":"Solar","state":"Gujarat","lon":69.72,"lat":22.84,"cap":"4.0 GW cell + module","status":"amber","weight":0.74,"note":"Domestic cell capacity \u2014 partially hedged against import duty.","policy":"PLI Tranche-II milestone review"},{"id":"oragadam","name":"Oragadam Auto Cluster","op":"Multi-OEM","sector":"Auto Components","state":"Tamil Nadu","lon":79.95,"lat":12.79,"cap":"~1.2 M units/yr","status":"amber","weight":0.79,"note":"Tier-1 component belt; PLI disbursement timing drives working capital.","policy":"PLI-Auto component scheme revision \u00b7 draft circulated"},{"id":"sriperumbudur","name":"Sriperumbudur Belt","op":"Multi-OEM","sector":"Auto Components","state":"Tamil Nadu","lon":79.94,"lat":12.96,"cap":"~900 k units/yr","status":"amber","weight":0.72,"note":"EV component transition capex concentrated here.","policy":"FAME-III localisation thresholds pending"},{"id":"hosur","name":"Hosur Industrial Belt","op":"Multi-OEM","sector":"Auto Components","state":"Tamil Nadu","lon":77.83,"lat":12.74,"cap":"~600 k units/yr","status":"clear","weight":0.42,"note":"Two-wheeler weighted; domestic demand led, low export beta.","policy":"No active proceeding"},{"id":"genome","name":"Genome Valley","op":"Multi-firm","sector":"Pharma","state":"Telangana","lon":78.55,"lat":17.55,"cap":"~180 facilities","status":"critical","weight":0.86,"note":"Generic formulation exporters with high US revenue share.","policy":"US HHS generic pricing review \u00b7 draft leaked to trade press"},{"id":"jeedimetla","name":"Jeedimetla API Cluster","op":"Multi-firm","sector":"Pharma","state":"Telangana","lon":78.44,"lat":17.51,"cap":"~350 API units","status":"amber","weight":0.68,"note":"API intermediates; China input dependency compounds price risk.","policy":"PLI-API bulk drug park milestones"},{"id":"hyd_pharmacity","name":"Hyderabad Pharma City","op":"TSIIC","sector":"Pharma","state":"Telangana","lon":78.32,"lat":17.11,"cap":"19,000 acres planned","status":"amber","weight":0.61,"note":"Greenfield capacity; approvals sensitive to export outlook.","policy":"Environmental clearance stage \u00b7 watch"}],"sectorState":{"Solar":"Gujarat","Steel":"Odisha","Auto Components":"Tamil Nadu","Pharma":"Telangana"},"stateCentre":{"Gujarat":[71.6,22.6],"Odisha":[84.8,20.6],"Tamil Nadu":[78.4,11.0],"Telangana":[79.0,17.9]}};
var GLYPH = { critical:['alert','g-crit'], amber:['up','g-amb'], clear:['down','g-clr'] };

function renderAssets(filterSector){
  var list = AD.assets.filter(function(a){ return !filterSector || a.sector===filterSector; });
  el("acount").textContent = AD.assets.length+" SITES";
  el("assetscope").textContent = filterSector ? (filterSector.toUpperCase()+" \u00b7 "+list.length) : "ALL SECTORS";
  el("assets").innerHTML = list.map(function(a){
    var g = GLYPH[a.status] || GLYPH.amber;
    return '<div class="arow" data-asset="'+a.id+'">'+
      '<span class="glyph '+g[1]+'">'+ic(g[0],12)+'</span>'+
      '<span class="sicon">'+ic(SECTOR_ICON[a.sector]||"grid",15)+'</span><div>'+
      '<div class="an">'+a.name+'</div>'+
      '<div class="am">'+a.op+' \u00b7 '+a.sector+' \u00b7 '+a.state+' \u00b7 '+a.cap+'</div>'+
      '<div class="ap">'+ic("signal",10,"ic-dim")+' '+a.policy+'</div>'+
      '</div></div>';
  }).join("");
  Array.prototype.forEach.call(document.querySelectorAll(".arow"), function(r){
    r.addEventListener("click", function(){
      if(window.__focusAsset) window.__focusAsset(r.dataset.asset);
      if(window.__openSite) window.__openSite(r.dataset.asset);
    });
  });
}
renderAssets(null);

var crawlHTML = CRAWL.map(function(c){
  return '<span><b>'+c[0]+'</b><i>'+c[1]+'</i>'+c[2]+'</span>';
}).join("");
el("crawl").innerHTML = crawlHTML + crawlHTML;

el("pause").innerHTML    = ic("pause")+"PAUSE SPIN";
el("clouds").innerHTML   = ic("cloud")+"CLOUDS";
el("recentre").innerHTML = ic("recentre")+"RE-LOCK";
Array.prototype.forEach.call(document.querySelectorAll(".hic"), function(n){
  n.innerHTML = ic(n.dataset.ic, 12);
});

(function tick(){
  var d=new Date();
  el("clock").textContent = d.toTimeString().slice(0,8);
  setTimeout(tick,1000);
})();


/* ===================== site detail canvas =====================
   A pin on a globe cannot carry a building silhouette: the camera always looks
   down at it. So the pin is only a locator, and the actual model lives here,
   in its own scene with its own camera, lighting and framing. */
/* Assets carry a `sector` ("Solar"), never a `type`. siteModel() matches on
   lowercase keys ("solar"), so `a.type || a.sector` fell straight through to
   the default box — which is why every site rendered as a yellow cube. */
var MODEL_TYPE = {
  "Steel":"steel", "Solar":"solar", "Auto Components":"auto",
  "Pharma":"pharma", "Policy":"policy", "Banking":"policy"
};
function modelTypeFor(a){
  if(/\bport\b/i.test(a.name)) return "port";
  return MODEL_TYPE[a.sector] || "policy";
}

/* Geographic overview runs entirely on OpenStreetMap: no key, no billing, no
   quota, no extra library. See openGeoView() for why Cesium is not used. */

var SITE = { renderer:null, raf:0, drag:false, lx:0, spin:0, idle:0, disp:[], asset:null };

function siteTeardown(){
  if(SITE.raf) cancelAnimationFrame(SITE.raf);
  SITE.raf = 0;
  for(var i=0;i<SITE.disp.length;i++){ if(SITE.disp[i] && SITE.disp[i].dispose) SITE.disp[i].dispose(); }
  SITE.disp = [];
  if(SITE.renderer){ SITE.renderer.dispose(); SITE.renderer = null; }
  geoTeardown();
}

function closeSite(){
  el("sitemodal").classList.remove("on");
  siteTeardown();
}

function openSite(aid){
  var a = null;
  for(var i=0;i<AD.assets.length;i++) if(AD.assets[i].id===aid) a = AD.assets[i];
  if(!a) return;

  var sec = null;
  for(var q=0;q<SECTORS.length;q++) if(SECTORS[q].n===a.sector) sec = SECTORS[q];
  var ratio = sec ? sec.r : 0.5;
  var crit = a.status === "critical";

  /* ---- panel copy ---- */
  var badgeCol = crit ? "var(--red)" : (a.status==="clear" ? "var(--green)" : "var(--amber)");
  var badgeBg  = crit ? "rgba(183,54,42,.14)" : (a.status==="clear" ? "rgba(79,158,106,.12)" : "rgba(201,166,58,.13)");
  el("sitetype").textContent = modelTypeFor(a).toUpperCase() + " SITE";
  el("siteinfo").innerHTML =
    '<h2 class="sm-name">'+a.name+'</h2>'+
    '<div class="sm-op">'+a.op+' \u00b7 '+a.state+'</div>'+
    '<span class="sm-badge" style="color:'+badgeCol+';background:'+badgeBg+';border:1px solid '+badgeCol+'">'+
      ic(crit?"alert":"up",10)+(crit?"CRITICAL":(a.status==="clear"?"CLEAR":"ELEVATED"))+'</span>'+
    '<div class="sm-grid">'+
      '<div class="sm-cell"><div class="sm-k">CAPACITY</div><div class="sm-v">'+a.cap+'</div></div>'+
      '<div class="sm-cell"><div class="sm-k">SECTOR</div><div class="sm-v">'+a.sector+'</div></div>'+
      '<div class="sm-cell"><div class="sm-k">SECTOR n(S)</div><div class="sm-v">'+ratio.toFixed(2)+' \u00b1 0.04</div></div>'+
      '<div class="sm-cell"><div class="sm-k">POSITION</div><div class="sm-v">'+a.lat.toFixed(2)+'\u00b0N '+a.lon.toFixed(2)+'\u00b0E</div></div>'+
    '</div>'+
    '<div class="sm-h">'+ic("signal",11)+'POLICY EXPOSURE</div>'+
    '<p class="sm-p">'+a.policy+'</p>'+
    '<div class="sm-h">'+ic("layers",11)+'TRANSMISSION CHAIN</div>'+
    '<div class="chain">'+
      '<div class="cstep crit"><span class="cdot"></span><span class="ctxt">'+
        '<span class="ck">EXOGENOUS TRIGGER</span><b>'+(a.trigger || "Policy action affecting "+a.sector)+'</b></span></div>'+
      '<div class="cstep hot"><span class="cdot"></span><span class="ctxt">'+
        '<span class="ck">SITE</span><b>'+a.name+'</b> \u2014 '+(a.note || a.cap)+'</span></div>'+
      '<div class="cstep hot"><span class="cdot"></span><span class="ctxt">'+
        '<span class="ck">PILLAR 1 \u00b7 HAWKES</span>Jump clustering lifts the branching ratio to '+
        '<span class="cnum">'+ratio.toFixed(2)+'</span>. Above <span class="cnum">1.00</span> the process is explosive.</span></div>'+
      '<div class="cstep"><span class="cdot"></span><span class="ctxt">'+
        '<span class="ck">PILLAR 2 \u00b7 RMT</span>Correlation with the '+a.sector+
        ' block rises, pushing an eigenvalue past the Marchenko\u2013Pastur bound.</span></div>'+
      '<div class="cstep"><span class="cdot"></span><span class="ctxt">'+
        '<span class="ck">PILLAR 3 \u00b7 REGIME</span>Hamilton filter posterior shifts toward the stressed state.</span></div>'+
      '<div class="cstep hot"><span class="cdot"></span><span class="ctxt">'+
        '<span class="ck">OUTPUT</span>Fused into <b>CSRS</b>. Sector-level elevation is not yet visible in the market-wide score.</span></div>'+
    '</div>'+
    '<div class="sm-h">'+ic("alert",11)+'NOTE</div>'+
    '<p class="sm-p">Illustrative values. This site is not yet wired to the live Kite/EOD2 pipeline.</p>';

  SITE.asset = a.id;
  el("sitemodal").classList.add("on");

  /* ---- schematic model, then the geographic overview beneath it ---- */
  siteTeardown();
  SITE.asset = a.id;
  el("geocount").textContent = "OPENSTREETMAP";
  openGeoView(a);
  var cvs = el("sitecanvas");
  var wrap = el("sitecanvaswrap");
  /* The schematic panel was removed; the overview + written panel are the
     detail view now. Bail before touching either element so this cannot throw
     when they are absent. */
  if(!cvs || !wrap) return;
  var w = Math.max(1, wrap.clientWidth), h = Math.max(1, wrap.clientHeight);

  if(typeof THREE === "undefined" || !window.SERAPH_GLOBE || !SERAPH_GLOBE.siteModel){
    el("sitehint").textContent = "3D unavailable \u2014 detail panel only";
    return;                                     // the written panel still shows
  }
  var r;
  try { r = new THREE.WebGLRenderer({ canvas:cvs, antialias:true, alpha:true }); }
  catch(e){ el("sitehint").textContent = "WebGL unavailable: "+(e&&e.message); return; }
  r.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
  r.setSize(w,h);
  SITE.renderer = r;

  var sc = new THREE.Scene();
  var cm = new THREE.PerspectiveCamera(38, w/h, 0.1, 200);
  cm.position.set(4.6, 3.5, 5.4);
  cm.lookAt(0, 1.05, 0);

  sc.add(new THREE.AmbientLight(0x4a4d55, 1.0));
  var k1 = new THREE.DirectionalLight(0xfff3e2, 1.15); k1.position.set(5,7,4); sc.add(k1);
  var k2 = new THREE.DirectionalLight(0x7fa8c8, 0.42); k2.position.set(-6,2.5,-4); sc.add(k2);

  var col = crit ? 0xd4553c : (a.status==="clear" ? 0x5f9e7a : 0xefb136);
  var pivot = new THREE.Group();
  pivot.add(SERAPH_GLOBE.siteModel(THREE, modelTypeFor(a), col, 1.0, SITE.disp));
  sc.add(pivot);

  var padG = new THREE.RingGeometry(1.55, 2.35, 48);
  var padM = new THREE.MeshBasicMaterial({ color: col, transparent:true, opacity:0.16, side:THREE.DoubleSide });
  var pad = new THREE.Mesh(padG, padM); pad.rotation.x = -Math.PI/2; pad.position.y = 0.005; sc.add(pad);
  var grid = new THREE.GridHelper(7, 14, 0x2a2e34, 0x1b1e23);
  grid.material.transparent = true; grid.material.opacity = 0.5;
  sc.add(grid);
  SITE.disp.push(padG, padM, grid.geometry, grid.material);

  SITE.spin = -0.6; SITE.idle = 0; SITE.drag = false;
  cvs.style.cursor = "grab";
  cvs.onpointerdown = function(e){ SITE.drag = true; SITE.lx = e.clientX; SITE.idle = 0; cvs.style.cursor="grabbing"; };
  cvs.onpointermove = function(e){
    if(!SITE.drag) return;
    SITE.spin += (e.clientX - SITE.lx)*0.011; SITE.lx = e.clientX; SITE.idle = 0;
  };
  cvs.onpointerup = cvs.onpointercancel = function(){ SITE.drag=false; cvs.style.cursor="grab"; };

  function loop(){
    SITE.raf = requestAnimationFrame(loop);
    var ww = Math.max(1,wrap.clientWidth), hh = Math.max(1,wrap.clientHeight);
    if(ww!==w || hh!==h){ w=ww; h=hh; r.setSize(w,h); cm.aspect=w/h; cm.updateProjectionMatrix(); }
    if(!SITE.drag){ SITE.idle += 1/60; if(SITE.idle>1.2) SITE.spin += 0.0042; }
    pivot.rotation.y = SITE.spin;
    r.render(sc, cm);
  }
  loop();
}

/* ---- OpenStreetMap overview, rendered in three.js ----
   Cesium was the obvious choice and it does not work here: it builds its tile
   decoders as web workers from blob: URLs, and a sandboxed iframe refuses them
   with a SecurityError. No version avoids that. Since three.js is already
   loaded and proven in this file, the overview is built directly:
     - ground : CARTO dark raster tiles on a plane grid
     - massing: real OSM building footprints from Overpass, extruded
   Local tangent plane, metres, +X east / -Z north / +Y up. */
var OVERPASS_ENDPOINTS = [
  "https://overpass-api.de/api/interpreter",
  "https://overpass.kumi.systems/api/interpreter",
  "https://maps.mail.ru/osm/tools/overpass/api/interpreter"
];
var TILE_URL = "https://basemaps.cartocdn.com/dark_all/{z}/{x}/{y}.png";
var OSM_CACHE = {};
var GEO = { renderer:null, raf:0, drag:false, lx:0, ly:0, theta:-0.5, phi:0.62, r:760, disp:[] };

function geoNotice(html){
  var n = document.getElementById("geonote");
  if(!n){
    n = document.createElement("div");
    n.id = "geonote"; n.className = "geomsg";
    el("geowrap").appendChild(n);
  }
  n.innerHTML = html; n.style.display = "flex";
}
function geoNoticeHide(){ var n=document.getElementById("geonote"); if(n) n.style.display="none"; }

function geoTeardown(){
  if(GEO.raf) cancelAnimationFrame(GEO.raf);
  GEO.raf = 0;
  for(var i=0;i<GEO.disp.length;i++){ if(GEO.disp[i] && GEO.disp[i].dispose) GEO.disp[i].dispose(); }
  GEO.disp = [];
  if(GEO.renderer){ GEO.renderer.dispose(); GEO.renderer = null; }
  el("geowrap").innerHTML = "";
}

/* metres per degree at this latitude */
function localScale(lat){
  return { mx: 111320 * Math.cos(lat*Math.PI/180), my: 110540 };
}

/* slippy tile maths */
function lon2tile(lon,z){ return (lon+180)/360*Math.pow(2,z); }
function lat2tile(lat,z){
  var r = lat*Math.PI/180;
  return (1 - Math.log(Math.tan(r) + 1/Math.cos(r))/Math.PI)/2*Math.pow(2,z);
}
function tile2lon(x,z){ return x/Math.pow(2,z)*360-180; }
function tile2lat(y,z){
  var n = Math.PI - 2*Math.PI*y/Math.pow(2,z);
  return 180/Math.PI*Math.atan(0.5*(Math.exp(n)-Math.exp(-n)));
}

function overpassFetch(query, i, ok, fail){
  if(i >= OVERPASS_ENDPOINTS.length){ fail("all Overpass mirrors refused or timed out"); return; }
  /* GET keeps it a simple request, so no CORS preflight */
  fetch(OVERPASS_ENDPOINTS[i] + "?data=" + encodeURIComponent(query))
    .then(function(r){ if(!r.ok) throw new Error("HTTP "+r.status); return r.json(); })
    .then(function(j){ ok(j.elements || []); })
    .catch(function(){ overpassFetch(query, i+1, ok, fail); });
}

function openGeoView(a){
  geoTeardown();
  var wrap = el("geowrap");
  geoNotice("<b>Loading OpenStreetMap\u2026</b><span>Fetching tiles and building footprints.</span>");

  var w = Math.max(1, wrap.clientWidth), h = Math.max(1, wrap.clientHeight);
  var r;
  try { r = new THREE.WebGLRenderer({ antialias:true, alpha:true }); }
  catch(e){ geoNotice("<b>WebGL unavailable.</b><span>"+(e&&e.message)+"</span>"); return; }
  r.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
  r.setSize(w,h);
  r.domElement.style.cssText = "position:absolute;inset:0;width:100%;height:100%;display:block;cursor:grab";
  wrap.insertBefore(r.domElement, wrap.firstChild);
  GEO.renderer = r;

  var sc = new THREE.Scene();
  var cam = new THREE.PerspectiveCamera(42, w/h, 1, 20000);
  sc.add(new THREE.AmbientLight(0x50555e, 1.0));
  var sun = new THREE.DirectionalLight(0xfff2df, 1.05); sun.position.set(400,700,300); sc.add(sun);
  var fill2 = new THREE.DirectionalLight(0x6d7c8f, 0.35); fill2.position.set(-500,200,-350); sc.add(fill2);

  var S = localScale(a.lat);

  /* ---- ground: 3x3 CARTO dark tiles around the site ---- */
  var Z = 16;
  var tx = Math.floor(lon2tile(a.lon,Z)), ty = Math.floor(lat2tile(a.lat,Z));
  var loader = new THREE.TextureLoader();
  loader.setCrossOrigin("anonymous");
  for(var dx=-1; dx<=1; dx++){
    for(var dy=-1; dy<=1; dy++){
      (function(gx,gy){
        var lonW = tile2lon(gx,Z),   lonE = tile2lon(gx+1,Z);
        var latN = tile2lat(gy,Z),   latS = tile2lat(gy+1,Z);
        var wM = (lonE-lonW)*S.mx,   hM = (latN-latS)*S.my;
        var cxM = ((lonW+lonE)/2 - a.lon)*S.mx;
        var czM = -(((latN+latS)/2) - a.lat)*S.my;   // north is -Z
        var url = TILE_URL.replace("{z}",Z).replace("{x}",gx).replace("{y}",gy);
        var g = new THREE.PlaneGeometry(wM, hM);
        var m = new THREE.MeshBasicMaterial({ color:0x2a2c30, transparent:true, opacity:0.95 });
        GEO.disp.push(g,m);
        var mesh = new THREE.Mesh(g,m);
        mesh.rotation.x = -Math.PI/2;
        mesh.position.set(cxM, 0, czM);
        sc.add(mesh);
        loader.load(url, function(tex){
          m.map = tex; m.color.setHex(0xffffff); m.needsUpdate = true;
          GEO.disp.push(tex);
        }, undefined, function(){ /* tile blocked: neutral slab stays */ });
      })(tx+dx, ty+dy);
    }
  }

  /* site marker ring */
  var ringG = new THREE.RingGeometry(150, 175, 64);
  var ringM = new THREE.MeshBasicMaterial({
    color: a.status==="critical" ? 0xd4553c : 0xefb136,
    transparent:true, opacity:0.75, side:THREE.DoubleSide, depthWrite:false
  });
  var ring = new THREE.Mesh(ringG, ringM);
  ring.rotation.x = -Math.PI/2; ring.position.y = 1.5;
  sc.add(ring); GEO.disp.push(ringG, ringM);

  /* ---- buildings ---- */
  var RAD = 700;
  var q = "[out:json][timeout:25];(way[\"building\"](around:"+RAD+","+a.lat+","+a.lon+"););out geom;";
  var cacheKey = a.id+":"+RAD;

  function drawBuildings(elements){
    var shapes = [], count = 0;
    var fill = new THREE.MeshPhongMaterial({
      color: a.status==="critical" ? 0x8a3a2c : 0x9c7a2e,
      emissive: 0x1a1408, shininess: 8, flatShading: true
    });
    GEO.disp.push(fill);
    for(var i=0;i<elements.length;i++){
      var wy = elements[i];
      if(wy.type!=="way" || !wy.geometry || wy.geometry.length<4) continue;
      var shp = new THREE.Shape();
      for(var g2=0; g2<wy.geometry.length; g2++){
        var X = (wy.geometry[g2].lon - a.lon)*S.mx;
        var Yn = (wy.geometry[g2].lat - a.lat)*S.my;   // +Y = north in shape space
        if(g2===0) shp.moveTo(X,Yn); else shp.lineTo(X,Yn);
      }
      var t = wy.tags || {};
      var hh = parseFloat(t.height);
      if(!(hh>0)){ var lv = parseFloat(t["building:levels"]); hh = (lv>0) ? lv*3.2 : 9; }
      var geo = new THREE.ExtrudeGeometry(shp, { depth:hh, bevelEnabled:false, steps:1, curveSegments:1 });
      /* shape plane is XY with +Y north; -90 deg about X puts the extrusion
         on world +Y and sends north to -Z, matching the ground tiles */
      geo.rotateX(-Math.PI/2);
      GEO.disp.push(geo);
      sc.add(new THREE.Mesh(geo, fill));
      count++;
    }
    if(count===0){
      geoNotice('<b>No OSM buildings mapped here.</b>'+
        '<span>OpenStreetMap has no building footprints within '+RAD+' m of this site \u2014 '+
        'normal for rural industrial estates. The basemap still shows the location.</span>');
      el("geocount").textContent = "NO FOOTPRINTS";
    } else {
      geoNoticeHide();
      el("geocount").textContent = count + " OSM BUILDINGS";
    }
  }

  if(OSM_CACHE[cacheKey]) drawBuildings(OSM_CACHE[cacheKey]);
  else overpassFetch(q, 0,
    function(els){ OSM_CACHE[cacheKey] = els; drawBuildings(els); },
    function(msg){
      geoNotice('<b>Overpass unavailable.</b><span>'+msg+'</span>'+
        '<span>Public mirrors rate limit hard. The basemap below is still live.</span>');
      el("geocount").textContent = "BASEMAP ONLY";
    });

  /* ---- orbit ---- */
  function place(){
    cam.position.set(
      GEO.r*Math.sin(GEO.phi)*Math.sin(GEO.theta),
      GEO.r*Math.cos(GEO.phi),
      GEO.r*Math.sin(GEO.phi)*Math.cos(GEO.theta)
    );
    cam.lookAt(0,0,0);
  }
  place();
  var cv2 = r.domElement;
  cv2.onpointerdown = function(e){ GEO.drag=true; GEO.lx=e.clientX; GEO.ly=e.clientY; cv2.style.cursor="grabbing"; };
  cv2.onpointermove = function(e){
    if(!GEO.drag) return;
    GEO.theta -= (e.clientX-GEO.lx)*0.006;
    GEO.phi = Math.max(0.12, Math.min(1.35, GEO.phi - (e.clientY-GEO.ly)*0.005));
    GEO.lx=e.clientX; GEO.ly=e.clientY; place();
  };
  cv2.onpointerup = cv2.onpointercancel = function(){ GEO.drag=false; cv2.style.cursor="grab"; };
  cv2.onwheel = function(e){
    e.preventDefault();
    GEO.r = Math.max(220, Math.min(2400, GEO.r + e.deltaY*0.6)); place();
  };

  function loop(){
    GEO.raf = requestAnimationFrame(loop);
    var ww=Math.max(1,wrap.clientWidth), hh=Math.max(1,wrap.clientHeight);
    if(ww!==w||hh!==h){ w=ww; h=hh; r.setSize(w,h); cam.aspect=w/h; cam.updateProjectionMatrix(); }
    if(!GEO.drag){ GEO.theta += 0.0009; place(); }
    r.render(sc,cam);
  }
  loop();
}

el("siteclose").innerHTML = ic("close",13);
el("siteclose").onclick = closeSite;
el("sitemodal").addEventListener("click", function(e){ if(e.target.id==="sitemodal") closeSite(); });
document.addEventListener("keydown", function(e){ if(e.key==="Escape") closeSite(); });
window.__openSite = openSite;

/* ===================== globe ===================== */
var stage = el("stage"), failEl = el("fail"), statusEl = el("status");
function die(m){ failEl.style.display="grid"; failEl.textContent=m; statusEl.textContent="failed"; }

