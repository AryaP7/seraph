.1,40.61],[-75.94,37.22],[-76.36,38.26],[-75.73,35.55],[-81.33,31.45],[-80.38,25.21],[-83.7,29.93],[-86.41,30.4],[-89.48,30.2],[-89.41,29.16],[-94.68,29.48],[-97.14,27.83],[-97.53,25.84],[-100.97,29.39],[-103.94,29.27],[-106.51,31.75],[-117.13,32.54],[-120.62,34.61],[-124.4,40.31],[-124.69,48.18]]},{"o":[[-168.11,65.67],[-161.93,66.12],[-166.76,68.36],[-156.58,71.36],[-140.99,69.71],[-140.98,60.34],[-137.45,58.92],[-135.48,59.79],[-129.98,55.29],[-131.97,55.5],[-134.1,58.12],[-142.56,60.08],[-147.13,60.88],[-151.72,59.16],[-150.64,61.27],[-158.43,55.99],[-164.79,54.4],[-157.23,58.77],[-161.97,58.67],[-166.12,61.5],[-164.56,63.15],[-160.85,63.74],[-161.15,64.76],[-168.11,65.67]]}],"india":[{"o":[[97.33,28.26],[97.13,27.08],[95.12,26.57],[92.67,22.04],[92.15,23.63],[91.71,22.99],[91.16,23.5],[92.38,24.98],[89.92,25.27],[88.56,26.45],[88.93,25.24],[88.08,24.5],[88.89,21.69],[86.98,21.5],[86.5,20.15],[80.32,15.9],[79.86,10.36],[77.54,7.97],[73.53,15.99],[72.63,21.36],[70.47,20.88],[68.18,23.69],[71.04,24.36],[69.51,26.94],[71.78,27.91],[75.26,32.27],[73.75,34.32],[77.84,35.49],[78.91,34.32],[78.74,31.52],[81.11,30.18],[80.09,28.79],[83.3,27.36],[88.06,26.41],[88.73,28.09],[89.74,26.72],[92.03,26.84],[91.7,27.77],[96.12,29.45],[96.25,28.41],[97.33,28.26]]}]}};

var CFG = {
  R:100, hotColor:0x9a7b0a, hotEdge:0xc9a63a,
  stars:true, starCount:2800,
  clouds:true, cloudOpacity:0.40, cloudSeed:7, cloudW:1024, cloudH:512,
  colors:{ ocean:0x0b0c0e, oceanEmissive:0x050506, atmosphere:0x2a2622,
           graticule:0x1c1c1e, land:0x2b2b2c, landEmissive:0x0a0a0b,
           coast:0x585a5d, stateLine:0x6b6459,
           oceanSpecular:0x0d0f12, oceanShininess:85, landSpecular:0x000000 },
  stress:{ "Gujarat":{ratio:.87}, "Odisha":{ratio:.81},
           "Tamil Nadu":{ratio:.79}, "Telangana":{ratio:.74} },
  triggers:[
    { id:"india", color:0x35322a, rings:DATA.groups.india,
      emissive:0.08, opacity:0.80 },
    { id:"us",    color:0x5e1a17, edge:0xb04a3e,
      rings:DATA.groups.us, edgeRings:DATA.edges.us, emissive:0.06, opacity:0.92 },
    { id:"eu",    color:0x2b1d47, edge:0x8163c4,
      rings:DATA.groups.eu, edgeRings:DATA.edges.eu, emissive:0.06, opacity:0.92 }
  ],
  arcs:[
    { id:"us", from:[-77.03,38.90], to:[72.6,23.0], color:0xc0392b },
    { id:"eu", from:[4.35,50.85],  to:[85.0,20.5], color:0x7c5cbf }
  ],
  trailPoints:48, guideOpacity:0.15,
  assets: AD.assets.map(function(a){
    return { id:a.id, lon:a.lon, lat:a.lat, sector:a.sector, state:a.state,
             weight:a.weight,
             color: a.status==="critical" ? 0xd4553c : (a.status==="clear" ? 0x5f9e7a : 0xefb136) };
  })
};

var scene = new THREE.Scene();
scene.background = new THREE.Color(0x020203);

var camera = new THREE.PerspectiveCamera(38, 1, 1, 6000);
var renderer;
try { renderer = new THREE.WebGLRenderer({antialias:true}); }
catch(e){ die("WebGL unavailable in this browser: "+(e&&e.message)); return; }
renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
stage.appendChild(renderer.domElement);
renderer.domElement.style.touchAction="none";
renderer.domElement.style.cursor="grab";

scene.add(new THREE.AmbientLight(0x232326, 1.0));
var sun = new THREE.DirectionalLight(0xf2ece2, 0.82); sun.position.set(120,240,200); scene.add(sun);
var fill = new THREE.DirectionalLight(0x6b5f4e, 0.22); fill.position.set(-240,60,-160); scene.add(fill);

var G = SERAPH_GLOBE.build(THREE, DATA, CFG);
scene.add(G.root);

/* floating labels for the raised states */
var tags = {};
G.anchors.forEach(function(a){
  var d=document.createElement("div"); d.className="tag";
  d.innerHTML='<div class="box">'+a.id+' · '+a.ratio.toFixed(2)+'</div><div class="stem"></div>';
  stage.appendChild(d); tags[a.id]=d;
});

/* ---- camera model: geographic lon/lat/radius, lookAt centre ---- */
var VIEWS = {
  india:  { lon:80, lat:20, r:235 },
  global: { lon:48, lat:24, r:335 },
  assets: { lon:79, lat:19, r:150 }
};
var view = { lon:80, lat:20, r:235 };
var want = null, mode="india", paused=false, selected=null, focusedAsset=null;
var dragging=false, moved=0, lx=0, ly=0;

function place(){
  var p = SERAPH_GLOBE.toXYZ(view.lon, view.lat, view.r);
  camera.position.set(p[0],p[1],p[2]);
  camera.up.set(0,1,0);
  camera.lookAt(0,0,0);
}
place();

/* Eased flight to an arbitrary lon/lat/r. Instant selection loses the spatial
   link between a panel row and a place, so every cross-panel action flies. */
var flight = null;
function flyTo(lon, lat, r, ms){
  var d = lon - view.lon;
  while (d >  180) { lon -= 360; d = lon - view.lon; }
  while (d < -180) { lon += 360; d = lon - view.lon; }
  flight = {
    t0: performance.now(), dur: ms || 900,
    from: { lon:view.lon, lat:view.lat, r:view.r },
    to:   { lon:lon, lat:lat, r:r === undefined ? view.r : r }
  };
  want = null;
}

function goTo(m){
  mode=m;
  /* flyTo already normalises the longitude to the short way round; the old
     lerp-target code that used to do it here dereferenced `want` one line
     after nulling it, which threw on every mode click. */
  flyTo(VIEWS[m].lon, VIEWS[m].lat, VIEWS[m].r, 1000);
  want=null;
  Array.prototype.forEach.call(document.querySelectorAll("#modes button"), function(b){
    b.classList.toggle("on", b.dataset.mode===m);
  });
  if (G.holoGroup) G.holoGroup.visible = (m === "assets");
  el("hint").textContent = (m==="assets")
    ? "asset holograms live \u00b7 click a beam for site detail"
    : "drag to orbit \u00b7 scroll to zoom \u00b7 click a highlighted region";
}
Array.prototype.forEach.call(document.querySelectorAll("#modes button"), function(b){
  b.addEventListener("click", function(){ goTo(b.dataset.mode); });
});
el("recentre").addEventListener("click", function(){ goTo(mode); });
el("clouds").addEventListener("click", function(){
  if(!G.clouds) return;
  G.clouds.visible = !G.clouds.visible;
  el("clouds").style.color = G.clouds.visible ? "#cfcdc8" : "";
});
el("pause").addEventListener("click", function(){
  paused=!paused;
  el("pause").innerHTML = paused ? ic("play")+"RESUME SPIN" : ic("pause")+"PAUSE SPIN";
});

var cv = renderer.domElement;
cv.addEventListener("pointerdown", function(e){
  dragging=true; moved=0; lx=e.clientX; ly=e.clientY; want=null; flight=null; cv.style.cursor="grabbing";
});
cv.addEventListener("pointermove", function(e){
  if(!dragging) return;
  var dx=e.clientX-lx, dy=e.clientY-ly; lx=e.clientX; ly=e.clientY;
  moved += Math.abs(dx)+Math.abs(dy);
  view.lon -= dx*0.22;
  view.lat = Math.max(-82, Math.min(82, view.lat + dy*0.22));
  place();
});
function up(e){ if(dragging && moved<6) pick(e); dragging=false; cv.style.cursor="grab"; }
cv.addEventListener("pointerup", up);
cv.addEventListener("pointercancel", up);
cv.addEventListener("wheel", function(e){
  e.preventDefault(); want=null; flight=null;
  view.r = Math.max(132, Math.min(620, view.r + e.deltaY*0.30));
  place();
}, {passive:false});

/* ---- picking ---- */
var ray=new THREE.Raycaster(), ndc=new THREE.Vector2();
function pick(e){
  var b=cv.getBoundingClientRect();
  ndc.x=((e.clientX-b.left)/b.width)*2-1;
  ndc.y=-((e.clientY-b.top)/b.height)*2+1;
  ray.setFromCamera(ndc,camera);

  /* Pins live under holoGroup, not in G.hot, and their meshes are nested — so
     they need a recursive pass of their own or they are simply not clickable. */
  if(G.holoGroup && G.holoGroup.visible){
    var ah = ray.intersectObjects(G.holoGroup.children, true);
    for(var p2=0;p2<ah.length;p2++){
      var au = ah[p2].object.userData || {};
      if(au.kind === "asset" && au.id){
        window.__focusAsset(au.id);
        if(window.__openSite) window.__openSite(au.id);
        return;
      }
    }
  }

  var hits=ray.intersectObjects(G.hot,false);
  var found=null;
  for(var j=0;j<hits.length;j++){
    var id2=hits[j].object.userData.id;
    if(id2 && id2!=="india"){ found=id2; break; }
  }
  focusedAsset=null;
  select(found);
}
/* Single entry point for selection. Everything — a globe click, a sector row, a
   signal, an asset row — routes through here so the card, the row highlight and
   the camera can never disagree with each other. */
function select(id, opts){
  opts = opts || {};
  selected = id;

  var d=el("detail");
  if(!id || !NODES[id]){ d.style.display="none"; }
  else {
    var n=NODES[id];
    d.style.display="block";
    el("dbody").innerHTML =
      '<div class="hd">'+n.hub+' \u00b7 '+n.time+'</div>'+
      '<div class="ttl">'+n.title+'</div>'+
      '<div class="trg">\u2316 '+n.trigger+'</div>'+
      '<div class="row"><b>'+n.sector+'</b><span>'+n.impact+'</span><span>'+n.mentions+' mentions today</span></div>';
  }

  /* mirror the selection onto the sector rows */
  var sector = id && NODES[id] ? NODES[id].sector : null;
  Array.prototype.forEach.call(document.querySelectorAll(".srow"), function(r){
    var on = sector && r.dataset.sector === sector;
    r.classList.toggle("on", !!on);
    if(on && opts.scroll !== false) r.scrollIntoView({block:"nearest", behavior:"smooth"});
  });

  /* asset panel filters to the selected sector */
  renderAssets(sector && AD.sectorState[sector] ? sector : null);
  syncAssetRow(null);

  if(opts.fly !== false && id){
    var c = AD.stateCentre[id];
    if(c) flyTo(c[0], c[1], Math.min(view.r, 205), 850);
    else if(id === "us") flyTo(-98, 39, 330, 1200);
    else if(id === "eu") flyTo(12, 50, 330, 1200);
  }
}

function syncAssetRow(aid){
  Array.prototype.forEach.call(document.querySelectorAll(".arow"), function(r){
    r.classList.toggle("on", r.dataset.asset === aid);
  });
}

/* asset focus: fly in tight, switch on the holograms, show the site card */
window.__focusAsset = function(aid){
  var a = null;
  for(var i=0;i<AD.assets.length;i++) if(AD.assets[i].id===aid) a=AD.assets[i];
  if(!a) return;
  focusedAsset = aid;
  syncAssetRow(aid);
  if(mode !== "assets"){
    mode = "assets";
    Array.prototype.forEach.call(document.querySelectorAll("#modes button"), function(b){
      b.classList.toggle("on", b.dataset.mode==="assets");
    });
    if(G.holoGroup) G.holoGroup.visible = true;
  }
  flyTo(a.lon, a.lat, 168, 950);
  var g = GLYPH[a.status] || GLYPH.amber;
  el("detail").style.display="block";
  el("dbody").innerHTML =
    '<div class="hd">'+a.op+' \u00b7 '+a.state+' \u00b7 '+a.cap+'</div>'+
    '<div class="ttl"><span class="'+g[1]+'">'+g[0]+'</span> '+a.name+'</div>'+
    '<div class="trg">\u2691 '+a.policy+'</div>'+
    '<div class="row"><b>'+a.sector+'</b><span>'+a.note+'</span></div>';
};

el("dclose").addEventListener("click", function(){ focusedAsset=null; syncAssetRow(null); select(null,{fly:false}); });

/* SECTOR STRESS row -> fly to the sector's state and open its card */
var SECTOR_NODE = {};
for(var nk in NODES){ if(NODES[nk].sector) SECTOR_NODE[NODES[nk].sector] = nk; }
Array.prototype.forEach.call(document.querySelectorAll(".srow"), function(r){
  r.addEventListener("click", function(){
    var st = AD.sectorState[r.dataset.sector];
    if(st){ focusedAsset=null; select(st); }
    else { renderAssets(null); }
  });
});

Array.prototype.forEach.call(document.querySelectorAll(".sig"), function(s){
  s.addEventListener("click", function(){
    focusedAsset=null;
    var k=s.dataset.focus;
    if(NODES[k]) select(k);
    else if(k==="Washington, DC") select("us");
    else if(k==="Brussels") select("eu");
    else if(k==="Mumbai" || k==="New Delhi") flyTo(78,21,235,900);
  });
});

/* ---- resize ---- */
function resize(){
  var w=Math.max(1,stage.clientWidth), h=Math.max(1,stage.clientHeight);
  renderer.setSize(w,h);
  camera.aspect=w/h; camera.updateProjectionMatrix();
  statusEl.textContent = w+"×"+h+" · "+G.stats.landTris.toLocaleString()+" land tris · 160 countries · 36 states · clouds procedural";
}
resize();
window.addEventListener("resize", resize);
if (window.ResizeObserver) new ResizeObserver(resize).observe(stage);

/* ---- loop ---- */
var proj=new THREE.Vector3(), t0=performance.now();
var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

function frame(now){
  requestAnimationFrame(frame);
  var t=(now-t0)/1000;

  if(flight){
    var ft = (now - flight.t0) / flight.dur;
    if(ft >= 1){ ft = 1; }
    var e2 = ft<0.5 ? 4*ft*ft*ft : 1-Math.pow(-2*ft+2,3)/2;   // easeInOutCubic
    view.lon = flight.from.lon + (flight.to.lon-flight.from.lon)*e2;
    view.lat = flight.from.lat + (flight.to.lat-flight.from.lat)*e2;
    view.r   = flight.from.r   + (flight.to.r  -flight.from.r  )*e2;
    place();
    if(ft>=1) flight=null;
  } else if(want){
    view.lon += (want.lon-view.lon)*0.09;
    view.lat += (want.lat-view.lat)*0.09;
    view.r   += (want.r  -view.r  )*0.09;
    if(Math.abs(want.lon-view.lon)<0.05 && Math.abs(want.r-view.r)<0.4) want=null;
    place();
  } else if(mode==="global" && !paused && !dragging && !reduce){
    view.lon -= 0.055; place();
  }

  /* highlights near the limb foreshorten into an unreadable smear — fade them */
  SERAPH_GLOBE.applyLimbFade(G, camera.position);

  /* cloud shell drifts west to east, independent of the globe */
  if(G.clouds && G.clouds.visible) G.clouds.rotation.y += reduce ? 0 : 0.00016;

  /* highlighted regions breathe; arcs carry a travelling pulse */
  for(var i=0;i<G.hot.length;i++){
    var m=G.hot[i], id=m.userData.id;
    if(id==="india") continue;
    var on = selected===id;
    var p = reduce?0.5:(Math.sin(t*1.8+i*1.2)*0.5+0.5);
    var be = m.userData.baseEmissive === undefined ? 0.26 : m.userData.baseEmissive;
    m.material.emissiveIntensity = (on ? be*2.4 : be) + p*be*0.55;
  }
  /* comet trail: rewrite the polyline each frame so the head sits at u and the
     tail trails behind, with vertex colours ramping to black. Under additive
     blending black contributes nothing, so it reads as a true fade-out. */
  for(var k=0;k<G.arcs.length;k++){
    var arc=G.arcs[k];
    var head=((t*0.17+arc.phase)%1);
    var span=0.30;
    var pos=arc.trail.geometry.attributes.position;
    var colA=arc.trail.geometry.attributes.color;
    var hot = selected===arc.id;
    for(var q=0;q<arc.n;q++){
      var f=q/(arc.n-1);                       // 0 = head, 1 = tail
      var u=head - f*span;
      if(u<0) u=0;
      var pt=arc.curve.getPoint(u);
      pos.setXYZ(q, pt.x, pt.y, pt.z);
      /* fade by trail position AND by how close the point is to the horizon —
         without the second term the arc is hard-clipped by the globe and reads
         as a severed line floating in space */
      var hf=SERAPH_GLOBE.horizonFade(pt.x,pt.y,pt.z,camera.position,G.R);
      var a3=Math.pow(1-f,2.1)*(hot?1.0:0.72)*hf;
      colA.setXYZ(q, arc.base.r*a3, arc.base.g*a3, arc.base.b*a3);
    }
    pos.needsUpdate=true; colA.needsUpdate=true;

    /* same treatment for the faint full-path guide */
    var gp=arc.line.geometry.attributes.position;
    var gc=arc.line.geometry.attributes.color;
    for(var q2=0;q2<arc.guideN;q2++){
      var gh=SERAPH_GLOBE.horizonFade(gp.getX(q2),gp.getY(q2),gp.getZ(q2),camera.position,G.R);
      var ga=gh*(hot?0.75:0.30);
      gc.setXYZ(q2, arc.base.r*ga, arc.base.g*ga, arc.base.b*ga);
    }
    gc.needsUpdate=true;

    var hp=arc.curve.getPoint(head);
    arc.dot.position.copy(hp);
    arc.dot.material.opacity = (hot?1.0:0.8)*SERAPH_GLOBE.horizonFade(hp.x,hp.y,hp.z,camera.position,G.R);
  }

  /* lean every site model toward the viewer before anything reads its pose */
  if(G.holoGroup && G.holoGroup.visible) SERAPH_GLOBE.faceCamera(G, camera);

  /* holograms: spin the cap ring, breathe the node, fade past the limb */
  if(G.holoGroup && G.holoGroup.visible){
    var camDist=camera.position.length();
    var camN=camera.position.clone().normalize();
    var hz=(G.R/camDist)+0.10;
    for(var hi=0;hi<G.holos.length;hi++){
      var ho=G.holos[hi];
      var vis=camN.dot(ho.dir);
      var kf=(vis-hz)/0.22; kf=kf<0?0:(kf>1?1:kf*kf*(3-2*kf));
      var sel = focusedAsset===ho.id;
      var pl = reduce?0.5:(Math.sin(t*2.4+hi*0.9)*0.5+0.5);
      ho.group.visible = kf>0.01;
      for(var mi=0;mi<ho.mats.length;mi++){
        ho.mats[mi].opacity = kf*(sel?1.0:0.62)*(0.72+pl*0.28);
      }
      /* Models are authored for ~r150. Without compensation they shrink to
         ~15px specks at India zoom and read as plain boxes. Exponent 0.6 is a
         partial correction: legible when far, not oversized when near. */
      var kz = Math.pow(camDist/150, 0.6);
      kz = kz<0.85?0.85:(kz>1.85?1.85:kz);
      ho.group.scale.setScalar(kz*(sel?1.22:1.0));
      if(!reduce) ho.ring.rotation.z += sel?0.045:0.016;
      var sc = sel ? 1.5+pl*0.35 : 1.0+pl*0.12;
      ho.node.scale.setScalar(sc);
    }
  }

  /* project state labels to screen */
  var w=cv.clientWidth, h=cv.clientHeight;
  for(var a=0;a<G.anchors.length;a++){
    var an=G.anchors[a], tg=tags[an.id];
    proj.copy(an.pos).project(camera);
    var cd = camera.position.length();
    var dotN = camera.position.dot(an.pos) / (cd * an.pos.length());
    var vis = proj.z<1 && dotN > (G.R/cd) + 0.12;   // same horizon rule as the fills
    tg.style.left=((proj.x*0.5+0.5)*w)+"px";
    tg.style.top =((-proj.y*0.5+0.5)*h)+"px";
    tg.style.opacity = vis ? "1" : "0";
    tg.className = "tag" + (selected===an.id ? " on" : "");
  }

  renderer.render(scene,camera);
}
requestAnimationFrame(frame);
}
</script>
</body>
</html>
