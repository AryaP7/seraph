APPENDIX A - tz_audit.py, verbatim

================================================================================
"""D-4: READ-ONLY audit of stored timestamps for IST correctness / silent UTC.

Issues only SELECT and SHOW. No INSERT/UPDATE/DELETE/DDL.
"""
import asyncio, sys
import asyncpg
sys.path.insert(0, r"C:\Users\Arlop\Downloads\SERAPH VARYA\SERAPH Varya")
from seraph.store.bootstrap import resolve_dsn  # noqa: E402

TABLES = ["intraday_bars", "hawkes_output", "rmt_output", "hamilton_output",
          "csrs", "reconciliation_state", "daily_prices", "ingestion_watermarks"]


async def main():
    pool = await asyncpg.create_pool(resolve_dsn(), min_size=1, max_size=2)
    try:
        print("server TimeZone:", await pool.fetchval("SHOW TimeZone"))
        print("server now():  ", await pool.fetchval("SELECT now()"))
        print()
        print("--- column types on the timestamp axis -------------------------")
        rows = await pool.fetch("""
            SELECT table_name, column_name, data_type
            FROM information_schema.columns
            WHERE table_schema='public'
              AND (data_type LIKE 'timestamp%' OR data_type='date'
                   OR data_type LIKE 'ARRAY')
            ORDER BY table_name, ordinal_position""")
        bad = []
        for r in rows:
            flag = ""
            if r["data_type"] == "timestamp without time zone":
                flag = "   <<< NAIVE COLUMN"
                bad.append((r["table_name"], r["column_name"]))
            print(f"  {r['table_name']:>24}.{r['column_name']:<22} {r['data_type']}{flag}")
        print(f"\nnaive (timestamp WITHOUT time zone) columns: {len(bad)} {bad}")

        print("\n--- stored values rendered in IST (+05:30) ---------------------")
        for t in TABLES:
            exists = await pool.fetchval(
                "SELECT to_regclass($1) IS NOT NULL", f"public.{t}")
            if not exists:
                print(f"  {t:>24}: (table absent)")
                continue
            cols = {r["column_name"] for r in await pool.fetch(
                "SELECT column_name FROM information_schema.columns "
                "WHERE table_schema='public' AND table_name=$1", t)}
            tscol = "ts" if "ts" in cols else ("date" if "date" in cols else
                     ("watermark" if "watermark" in cols else None))
            n = await pool.fetchval(f"SELECT count(*) FROM {t}")
            if tscol is None or n == 0:
                print(f"  {t:>24}: rows={n:<12} (no ts column)" if tscol is None
                      else f"  {t:>24}: rows=0")
                continue
            q = (f"SELECT min({tscol}) lo, max({tscol}) hi FROM {t}")
            r = await pool.fetchrow(q)
            extra = ""
            if tscol == "ts":
                dt = await pool.fetchval(
                    f"SELECT data_type FROM information_schema.columns "
                    f"WHERE table_schema='public' AND table_name='{t}' "
                    f"AND column_name='ts'")
                if dt == "timestamp with time zone":
                    h = await pool.fetch(
                        f"SELECT min(({tscol} AT TIME ZONE 'Asia/Kolkata')::time) a,"
                        f"       max(({tscol} AT TIME ZONE 'Asia/Kolkata')::time) b,"
                        f"       count(DISTINCT ({tscol} AT TIME ZONE 'Asia/Kolkata')::time) c"
                        f" FROM {t}")
                    extra = (f"  IST time-of-day span {h[0]['a']}..{h[0]['b']} "
                             f"({h[0]['c']} distinct)")
            print(f"  {t:>24}: rows={n:<12} {r['lo']} .. {r['hi']}{extra}")

        print("\n--- NSE session sanity: bars must sit inside 09:15-15:30 IST ---")
        oob = await pool.fetchval(
            "SELECT count(*) FROM intraday_bars "
            "WHERE (ts AT TIME ZONE 'Asia/Kolkata')::time < '09:15'::time "
            "   OR (ts AT TIME ZONE 'Asia/Kolkata')::time > '15:30'::time")
        tot = await pool.fetchval("SELECT count(*) FROM intraday_bars")
        print(f"  bars outside 09:15-15:30 IST: {oob:,} / {tot:,}"
              f"  ({100.0*oob/max(tot,1):.4f}%)")
        print("  (a silent UTC coercion would put ~100% of bars at 14:45-21:00 IST)")

        print("\n--- reconciliation_state.tau_last_update element type ----------")
        r = await pool.fetchrow(
            "SELECT data_type, udt_name FROM information_schema.columns "
            "WHERE table_schema='public' AND table_name='reconciliation_state' "
            "AND column_name='tau_last_update'")
        print(f"  {dict(r) if r else 'absent'}   (_timestamptz = tz-aware array OK)")
    finally:
        await pool.close()

asyncio.run(main())

