"""D-4: READ-ONLY characterisation of off-session intraday bars and hawkes_output
emission times."""
import asyncio, sys
import asyncpg
sys.path.insert(0, r"C:\Users\Arlop\Downloads\SERAPH VARYA\SERAPH Varya")
from seraph.store.bootstrap import resolve_dsn  # noqa: E402

async def main():
    pool = await asyncpg.create_pool(resolve_dsn(), min_size=1, max_size=2)
    try:
        print("=== off-session intraday_bars, grouped by IST date ===")
        rows = await pool.fetch("""
            SELECT (ts AT TIME ZONE 'Asia/Kolkata')::date AS d,
                   count(*) AS n,
                   count(DISTINCT symbol) AS syms,
                   min((ts AT TIME ZONE 'Asia/Kolkata')::time) AS lo,
                   max((ts AT TIME ZONE 'Asia/Kolkata')::time) AS hi
            FROM intraday_bars
            WHERE (ts AT TIME ZONE 'Asia/Kolkata')::time < '09:15'::time
               OR (ts AT TIME ZONE 'Asia/Kolkata')::time > '15:30'::time
            GROUP BY 1 ORDER BY 1""")
        print(f"  distinct dates carrying off-session bars: {len(rows)}")
        print(f"  {'date':>12} {'bars':>7} {'symbols':>8} {'IST window':>22}")
        for r in rows:
            print(f"  {str(r['d']):>12} {r['n']:>7} {r['syms']:>8}   {r['lo']}..{r['hi']}")
        print("\n  Do these dates ALSO carry a regular 09:15-15:30 session?")
        for r in rows:
            n_reg = await pool.fetchval("""
                SELECT count(*) FROM intraday_bars
                WHERE (ts AT TIME ZONE 'Asia/Kolkata')::date = $1
                  AND (ts AT TIME ZONE 'Asia/Kolkata')::time BETWEEN '09:15' AND '15:30'
                """, r["d"])
            print(f"    {r['d']}: off-session={r['n']:>5}  in-session={n_reg:>5}")

        print("\n=== hawkes_output emission times (IST) ===")
        rows = await pool.fetch("""
            SELECT (ts AT TIME ZONE 'Asia/Kolkata')::time AS t, count(*) AS n,
                   min((ts AT TIME ZONE 'Asia/Kolkata')::date) AS first_d,
                   max((ts AT TIME ZONE 'Asia/Kolkata')::date) AS last_d
            FROM hawkes_output GROUP BY 1 ORDER BY 2 DESC""")
        for r in rows:
            print(f"  {r['t']}  n={r['n']:>4}   {r['first_d']} .. {r['last_d']}")

        print("\n=== csrs emission times (IST) ===")
        rows = await pool.fetch("""
            SELECT (ts AT TIME ZONE 'Asia/Kolkata')::time AS t, count(*) AS n
            FROM csrs GROUP BY 1 ORDER BY 2 DESC""")
        for r in rows:
            print(f"  {r['t']}  n={r['n']}")

        print("\n=== distinct intraday bar times per session, histogram ===")
        rows = await pool.fetch("""
            SELECT k, count(*) AS sessions FROM (
              SELECT (ts AT TIME ZONE 'Asia/Kolkata')::date AS d,
                     count(DISTINCT (ts AT TIME ZONE 'Asia/Kolkata')::time) AS k
              FROM intraday_bars GROUP BY 1) s
            GROUP BY k ORDER BY sessions DESC LIMIT 12""")
        for r in rows:
            print(f"  {r['k']:>4} distinct bar-times  -> {r['sessions']:>5} sessions")
    finally:
        await pool.close()

asyncio.run(main())
