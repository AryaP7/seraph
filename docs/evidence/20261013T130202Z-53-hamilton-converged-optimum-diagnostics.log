#!/usr/bin/env python3
"""D-3 - is the DISCARDED higher-llf candidate a statistically valid optimum?

Workstream D diagnostic for docs/evidence/HAMILTON-CAUSAL-POSTFIX.md section 5.
Causal walk-forward blocks 10 and 11 are the surviving 2/14 nesting violations:
fit() selected a CONVERGED candidate whose llf sits BELOW its own nested
restriction, discarding a NON-CONVERGED candidate that sits above it.

This script changes nothing. It re-runs the exact start enumeration fit() uses,
keeps the parameters of the discarded candidate (which fit() throws away), and
measures at BOTH points:

  * gradient norm (scipy's own 'gopt' from the BFGS retvals, plus an
    independent numerical gradient of the log-likelihood)
  * numerical Hessian eigenvalues / condition number -> genuine local maximum
    (all eigenvalues < 0), saddle (mixed signs), or ridge (eigenvalues ~ 0)
  * distance to the parameter-space boundary: implied transition probabilities
    (logit saturation) and regime variances (positivity)
  * scipy's warnflag, which says WHY the convergence test failed

READ-ONLY on the database (one SELECT). Persists nothing.
"""
import asyncio
import json
import os
import sys
import time
import warnings

import numpy as np

REPO = r"C:\Users\Arlop\Downloads\SERAPH VARYA\SERAPH Varya"
sys.path.insert(0, REPO)

import asyncpg                                              # noqa: E402
from scipy.optimize import approx_fprime                    # noqa: E402

from seraph.store.bootstrap import resolve_dsn              # noqa: E402
from seraph.orchestration.hamilton_causal import (          # noqa: E402
    DEFAULT_INITIAL_TRAIN,
    DEFAULT_REFIT_EVERY,
    causal_tvtp_exog,
)
from seraph.pillars.hamilton.engine import (                # noqa: E402
    K_REGIMES,
    MultivariateTVTPHamilton,
    _tvtp_start_from_constant,
    _tvtp_start_from_intercept_only,
)

BLOCKS = [int(b) for b in os.environ.get("D3_BLOCKS", "10,11").split(",")]
MAXITER, RESTARTS, SEED = 200, 4, 0

REPORT_KEYS = (
    "llf", "n_params", "scipy_warnflag", "scipy_iterations", "scipy_gopt_norm",
    "grad_norm_constrained", "grad_max_abs_constrained",
    "grad_norm_unconstrained", "grad_max_abs_unconstrained",
    "hessian_eig_min", "hessian_eig_max",
    "hessian_n_positive", "hessian_n_negative", "hessian_cond_number",
    "hessian_n_near_zero_rel_1e6", "hessian_n_near_zero_rel_1e8",
    "verdict_curvature", "transition_params_absmax",
    "min_offdiag_transition_prob", "max_selfpersistence_prob",
    "frac_dates_offdiag_below_1e6", "variance_min",
)


async def load():
    conn = await asyncpg.connect(resolve_dsn(), timeout=30)
    rows = await conn.fetch(
        "SELECT date, rv_t_yz, ar_t, bas_t FROM hamilton_output ORDER BY date")
    await conn.close()
    return rows


def enumerate_starts(model, y):
    """Exactly fit()'s start list, in fit()'s order."""
    sp0 = np.asarray(model.start_params, dtype=float)
    tr = model.parameters["regime_transition"]
    starts = [("statsmodels_default", None)]
    rng = np.random.default_rng(SEED)
    for k in range(RESTARTS):
        sp = sp0.copy()
        sp[tr] = rng.uniform(-2.0, 2.0, size=np.asarray(sp0)[tr].size)
        starts.append(("random_%d" % k, sp))
    if model.tvtp:
        w = _tvtp_start_from_constant(
            model, y, k_regimes=K_REGIMES, maxiter=MAXITER,
            restarts=RESTARTS, seed=SEED)
        if w is not None:
            starts.append(("warm_from_constant", w))
        if model.k_tvtp > 1:
            w2 = _tvtp_start_from_intercept_only(
                model, y, k_regimes=K_REGIMES, maxiter=MAXITER,
                restarts=RESTARTS, seed=SEED)
            if w2 is not None:
                starts.append(("warm_from_intercept_only", w2))
    return starts


def diagnose(model, params, label):
    """Gradient, Hessian and boundary diagnostics at `params` (constrained)."""
    out = {"label": label}
    p = np.asarray(params, dtype=float)
    nobs = float(model.nobs)

    def ll_t(x):
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            try:
                return float(model.loglike(x, transformed=True))
            except Exception:
                return -1e18

    def ll_u(x):
        with warnings.catch_warnings():
            warnings.simplefilter("ignore")
            try:
                return float(model.loglike(x, transformed=False))
            except Exception:
                return -1e18

    try:
        u = np.asarray(model.untransform_params(p), dtype=float)
    except Exception:
        u = None

    out["llf"] = ll_t(p)
    step = 1e-5
    g_t = approx_fprime(p, ll_t, step)
    out["grad_norm_constrained"] = float(np.linalg.norm(g_t))
    out["grad_max_abs_constrained"] = float(np.max(np.abs(g_t)))
    if u is not None:
        g_u = approx_fprime(u, ll_u, step)
        out["grad_norm_unconstrained"] = float(np.linalg.norm(g_u))
        out["grad_max_abs_unconstrained"] = float(np.max(np.abs(g_u)))

    base = u if u is not None else p
    fn = ll_u if u is not None else ll_t
    k = int(base.size)
    h = 1e-4 * np.maximum(np.abs(base), 1.0)
    H = np.zeros((k, k))
    for i in range(k):
        for j in range(i, k):
            ei = np.zeros(k)
            ei[i] = h[i]
            ej = np.zeros(k)
            ej[j] = h[j]
            fpp = fn(base + ei + ej)
            fpm = fn(base + ei - ej)
            fmp = fn(base - ei + ej)
            fmm = fn(base - ei - ej)
            H[i, j] = H[j, i] = (fpp - fpm - fmp + fmm) / (4.0 * h[i] * h[j])
    H = 0.5 * (H + H.T)
    ev = np.linalg.eigvalsh(H)
    nz = np.abs(ev)
    out["n_params"] = k
    out["hessian_eigenvalues_sorted"] = [float(v) for v in ev]
    out["hessian_eig_min"] = float(ev.min())
    out["hessian_eig_max"] = float(ev.max())
    out["hessian_n_positive"] = int((ev > 0).sum())
    out["hessian_n_negative"] = int((ev < 0).sum())
    out["hessian_cond_number"] = float(nz.max() / max(nz.min(), 1e-300))
    out["hessian_n_near_zero_rel_1e6"] = int((nz < 1e-6 * nz.max()).sum())
    out["hessian_n_near_zero_rel_1e8"] = int((nz < 1e-8 * nz.max()).sum())
    if ev.max() < 0:
        out["verdict_curvature"] = "negative definite -> genuine local MAXIMUM"
    elif ev.min() > 0:
        out["verdict_curvature"] = "positive definite -> local MINIMUM (!)"
    else:
        out["verdict_curvature"] = (
            "indefinite -> SADDLE (%d ascent direction(s) remain)"
            % out["hessian_n_positive"])

    try:
        sl = model.parameters["regime_transition"]
        tp = np.ravel(p[sl])
        out["transition_params_absmax"] = float(np.max(np.abs(tp)))
        out["transition_params"] = [round(float(v), 4) for v in tp]
    except Exception as exc:
        out["transition_params_error"] = repr(exc)
    try:
        rt = np.asarray(model.regime_transition_matrix(p), dtype=float)
        off = rt.copy()
        for i in range(min(rt.shape[0], rt.shape[1])):
            off[i, i, ...] = np.nan
        flat = off.reshape(-1, off.shape[-1]) if off.ndim == 3 else off.reshape(-1, 1)
        out["min_offdiag_transition_prob"] = float(np.nanmin(off))
        out["max_selfpersistence_prob"] = float(np.nanmax(
            np.array([rt[i, i, ...] for i in range(rt.shape[0])])))
        out["frac_dates_offdiag_below_1e6"] = float(
            np.mean(np.nanmin(flat, axis=0) < 1e-6))
    except Exception as exc:
        out["transition_matrix_error"] = repr(exc)
    try:
        vs = [float(p[model.parameters[j, "variances"]][0])
              for j in range(K_REGIMES)]
        out["variances"] = vs
        out["variance_min"] = min(vs)
    except Exception as exc:
        out["variances_error"] = repr(exc)
    return out


def main():
    rows = asyncio.run(load())
    dates = [str(r["date"]) for r in rows]
    y = np.array([[float(r["rv_t_yz"]), float(r["ar_t"]), float(r["bas_t"])]
                  for r in rows])
    exog = causal_tvtp_exog(y[:, 0])
    print("INPUT : %d obs  %s .. %s" % (len(dates), dates[0], dates[-1]))
    print("CONFIG: initial_train=%d refit_every=%d K=%d exog=%s"
          % (DEFAULT_INITIAL_TRAIN, DEFAULT_REFIT_EVERY, K_REGIMES, exog.shape))
    print("BLOCKS: %s\n" % BLOCKS)

    results = {}
    for b in BLOCKS:
        t_k = DEFAULT_INITIAL_TRAIN + DEFAULT_REFIT_EVERY * b
        y_tr, x_tr = y[:t_k], exog[:t_k]
        print("=" * 78)
        print("BLOCK %d:  train_n=%d  train_last=%s" % (b, t_k, dates[t_k - 1]))
        print("=" * 78)
        sys.stdout.flush()
        model = MultivariateTVTPHamilton(y_tr, exog_tvtp=x_tr,
                                         k_regimes=K_REGIMES)
        t0 = time.time()
        starts = enumerate_starts(model, y_tr)
        print("  start enumeration: %d candidates (%.0fs incl. nested "
              "restricted fits)" % (len(starts), time.time() - t0))
        sys.stdout.flush()

        cands = []
        for name, sp in starts:
            t1 = time.time()
            try:
                with warnings.catch_warnings():
                    warnings.simplefilter("ignore")
                    r = model.fit(start_params=sp, maxiter=MAXITER, disp=False)
            except Exception as exc:
                print("    %26s: FAILED %r" % (name, exc))
                sys.stdout.flush()
                continue
            rv = getattr(r, "mle_retvals", {}) or {}
            conv = bool(rv.get("converged", True)) if isinstance(rv, dict) else True
            gopt = rv.get("gopt")
            gn = (float(np.linalg.norm(np.asarray(gopt, dtype=float)))
                  if gopt is not None else float("nan"))
            cands.append({
                "start": name, "llf": float(r.llf), "converged": conv,
                "iterations": int(rv.get("iterations", -1)),
                "warnflag": int(rv.get("warnflag", -1)),
                "scipy_gopt_norm": gn,
                "params": np.asarray(r.params, dtype=float).copy(),
            })
            print("    %26s: llf=%12.2f conv=%-5s iter=%4s warnflag=%s "
                  "|gopt|=%.4e  (%.0fs)"
                  % (name, r.llf, conv, rv.get("iterations", -1),
                     rv.get("warnflag", -1), gn, time.time() - t1))
            sys.stdout.flush()

        conv_c = [c for c in cands if c["converged"]]
        nonc_c = [c for c in cands if not c["converged"]]
        sel = max(conv_c, key=lambda c: c["llf"]) if conv_c else None
        dis = max(nonc_c, key=lambda c: c["llf"]) if nonc_c else None
        print("\n  SELECTED (best converged)      : %s  llf=%s"
              % (sel["start"] if sel else None, sel["llf"] if sel else None))
        print("  DISCARDED (best non-converged) : %s  llf=%s"
              % (dis["start"] if dis else None, dis["llf"] if dis else None))
        if sel and dis:
            print("  gap (discarded - selected)     : %+.2f llf"
                  % (dis["llf"] - sel["llf"]))
        sys.stdout.flush()

        diags = []
        for tag, c in (("SELECTED_converged", sel),
                       ("DISCARDED_nonconverged", dis)):
            if c is None:
                continue
            print("\n  --- diagnostics at %s (%s) ---" % (tag, c["start"]))
            sys.stdout.flush()
            t1 = time.time()
            d = diagnose(model, c["params"], "%s:%s" % (tag, c["start"]))
            d["scipy_warnflag"] = c["warnflag"]
            d["scipy_gopt_norm"] = c["scipy_gopt_norm"]
            d["scipy_iterations"] = c["iterations"]
            diags.append(d)
            for key in REPORT_KEYS:
                if key in d:
                    v = d[key]
                    txt = v if isinstance(v, str) else ("%.6g" % v)
                    print("      %-36s %s" % (key, txt))
            ev = np.array(d["hessian_eigenvalues_sorted"])
            print("      3 most negative Hessian eigenvalues : %s" % ev[:3])
            print("      3 smallest |eigenvalue|             : %s"
                  % ev[np.argsort(np.abs(ev))][:3])
            print("      (%.0fs)" % (time.time() - t1))
            sys.stdout.flush()
        results[str(b)] = {
            "train_n": t_k, "train_last": dates[t_k - 1],
            "candidates": [{k: v for k, v in c.items() if k != "params"}
                           for c in cands],
            "diagnostics": diags,
        }
        print()
        sys.stdout.flush()

    print("=" * 78)
    print("MACHINE-READABLE SUMMARY")
    print("=" * 78)
    print(json.dumps(results, indent=2, default=str))


main()
