APPENDIX A - script for PART 1 (lm_size.py), verbatim

================================================================================
"""Monte-Carlo size/power check of the Lee-Mykland implementation in C4.

Under H0 (pure Brownian, no jumps) the L&M test with level alpha rejects
*anywhere in the sample* with probability ~alpha (it is a max-statistic /
family-wise test). So the fraction of SAMPLES containing >=1 detection should
be ~alpha, and the per-bar FPR should be ~alpha/n.
"""
import sys
import numpy as np

sys.path.insert(0, r"C:\Users\Arlop\Downloads\SERAPH VARYA\SERAPH Varya")
from seraph.features.jump_extraction import (  # noqa: E402
    LM_ALPHA, LM_WINDOW_K, bipower_volatility, extract_jumps,
    lee_mykland_threshold, _C_CONST,
)

rng = np.random.default_rng(20261013)
N_BARS = 2475            # matches the CT-3 fetch window
SIGMA = 0.0012           # ~ typical 5-min equity log-return sd
REPS = 400

print(f"c = E|N(0,1)| = {_C_CONST:.6f}   1/c = {1/_C_CONST:.6f}")
for n in (500, 2319, 2475, 18781302):
    thr = lee_mykland_threshold(n)
    print(f"  threshold(n_obs={n:>9}) = {thr:.4f}   thr*c = {thr*_C_CONST:.4f}")

# --- sigma-hat scaling check: is sigma_hat an unbiased estimate of sigma? ---
r = rng.normal(0.0, SIGMA, size=200_000)
sig = bipower_volatility(r, LM_WINDOW_K)
sig = sig[np.isfinite(sig)]
print(f"\n[sigma scaling] true sigma={SIGMA:.6g}  mean sigma_hat={sig.mean():.6g}"
      f"  ratio={sig.mean()/SIGMA:.4f}   (1/c={1/_C_CONST:.4f}, c={_C_CONST:.4f})")

# --- empirical size of the shipped implementation ---
hits_per_sample, any_hit = [], 0
for _ in range(REPS):
    rr = rng.normal(0.0, SIGMA, size=N_BARS)
    prices = 100.0 * np.exp(np.cumsum(rr))
    out = extract_jumps(prices)
    h = int(out["is_jump"].sum())
    hits_per_sample.append(h)
    any_hit += h > 0
hits = np.array(hits_per_sample)
print(f"\n[SHIPPED, H0 no jumps] reps={REPS} bars/rep={N_BARS}")
print(f"  P(>=1 detection in a sample) = {any_hit/REPS:.4f}   target alpha = {LM_ALPHA}")
print(f"  mean detections/sample = {hits.mean():.4f}  max = {hits.max()}")

# --- the same, with the threshold rescaled by c (single-correction variant) ---
def extract_jumps_rescaled(prices, k=LM_WINDOW_K, alpha=LM_ALPHA):
    p = np.asarray(prices, float)
    lr = np.zeros(p.size)
    lr[1:] = np.diff(np.log(p))
    sg = bipower_volatility(lr, k)
    with np.errstate(invalid="ignore", divide="ignore"):
        stat = np.abs(lr) / sg
    stat = np.nan_to_num(stat)
    thr = lee_mykland_threshold(int(np.isfinite(sg).sum()), alpha) * _C_CONST
    isj = stat > thr
    return isj, thr

any_hit2, hits2 = 0, []
for _ in range(REPS):
    rr = rng.normal(0.0, SIGMA, size=N_BARS)
    prices = 100.0 * np.exp(np.cumsum(rr))
    isj, thr2 = extract_jumps_rescaled(prices)
    h = int(isj.sum()); hits2.append(h); any_hit2 += h > 0
hits2 = np.array(hits2)
print(f"\n[RESCALED thr*c, H0 no jumps] threshold={thr2:.4f}")
print(f"  P(>=1 detection in a sample) = {any_hit2/REPS:.4f}   target alpha = {LM_ALPHA}")
print(f"  mean detections/sample = {hits2.mean():.4f}  max = {hits2.max()}")

# --- power: inject one jump of m*sigma at a known bar ---
print("\n[POWER] single injected jump, detection rate over 200 reps")
print(f"{'m*sigma':>8} {'shipped':>9} {'rescaled':>9}")
for m in (4, 5, 6, 7, 8, 10):
    d1 = d2 = 0
    for _ in range(200):
        rr = rng.normal(0.0, SIGMA, size=N_BARS)
        idx = 1200
        rr[idx] += -m * SIGMA
        prices = 100.0 * np.exp(np.cumsum(rr))
        o = extract_jumps(prices)
        d1 += bool(o["is_jump"][idx])
        isj, _ = extract_jumps_rescaled(prices)
        d2 += bool(isj[idx])
    print(f"{m:>8} {d1/200:>9.3f} {d2/200:>9.3f}")

