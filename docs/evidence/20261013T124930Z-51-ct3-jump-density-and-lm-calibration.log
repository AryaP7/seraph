"""D-1: measured negative-jump density on the real corpus, under the shipped
Lee-Mykland threshold and under the mu_1-corrected (x c) threshold.

READ-ONLY on the database. No writes of any kind.
"""
import asyncio, os, sys, time
import numpy as np
import asyncpg

sys.path.insert(0, r"C:\Users\Arlop\Downloads\SERAPH VARYA\SERAPH Varya")
from seraph.features.jump_extraction import (  # noqa: E402
    LM_ALPHA, LM_WINDOW_K, bipower_volatility, lee_mykland_threshold, _C_CONST,
)
from seraph.ingestion.hawkes_universe import build_symbol_list  # noqa: E402
from seraph.store.bootstrap import resolve_dsn  # noqa: E402

LIMIT = int(os.environ.get("SYM_LIMIT", "0")) or None
BARS_PER_DAY = 75


def signs(close, k=LM_WINDOW_K, alpha=LM_ALPHA):
    p = np.asarray(close, float)
    lr = np.zeros(p.size)
    with np.errstate(divide="ignore", invalid="ignore"):
        lr[1:] = np.diff(np.log(np.where(p > 0, p, np.nan)))
    lr = np.nan_to_num(lr)
    sg = bipower_volatility(lr, k)
    with np.errstate(divide="ignore", invalid="ignore"):
        stat = np.nan_to_num(np.abs(lr) / sg)
    n_fin = int(np.isfinite(sg).sum())
    thr_ship = lee_mykland_threshold(n_fin, alpha)
    thr_corr = thr_ship * _C_CONST
    out = {}
    for name, thr in (("shipped", thr_ship), ("corrected", thr_corr)):
        isj = (stat > thr) & (lr != 0)
        sgn = np.where(isj, np.sign(lr), 0)
        out[name] = (int((sgn == -1).sum()), int((sgn == 1).sum()))
    return out, n_fin, thr_ship, thr_corr


async def main():
    pool = await asyncpg.create_pool(resolve_dsn(), min_size=1, max_size=2)
    try:
        members = await pool.fetchval(
            "SELECT members FROM universe_snapshots ORDER BY rebalance_date DESC LIMIT 1")
        syms = build_symbol_list(list(members))
        if LIMIT:
            syms = syms[:LIMIT]
        print(f"universe symbols considered: {len(syms)}")
        tot = {"shipped": [0, 0], "corrected": [0, 0]}
        tot_bars = 0
        tot_symdays = 0
        per_sym = []
        t0 = time.time()
        for i, s in enumerate(syms, 1):
            rows = await pool.fetch(
                "SELECT ts, close FROM intraday_bars WHERE symbol=$1 ORDER BY ts", s)
            if len(rows) < 200:
                continue
            close = np.fromiter((float(r["close"]) for r in rows), float, len(rows))
            dates = {r["ts"].date() for r in rows}
            res, n_fin, ts_, tc_ = signs(close)
            symdays = len(dates)
            tot_bars += len(rows)
            tot_symdays += symdays
            for kk in tot:
                tot[kk][0] += res[kk][0]
                tot[kk][1] += res[kk][1]
            per_sym.append((s, symdays, res["shipped"][0], res["corrected"][0]))
            if i % 10 == 0:
                print(f"  ... {i}/{len(syms)} symbols, {time.time()-t0:.0f}s", flush=True)
        print(f"\nbars={tot_bars:,}  symbol-days={tot_symdays:,}  "
              f"elapsed={time.time()-t0:.0f}s")
        print(f"threshold (last symbol): shipped={ts_:.4f}  corrected={tc_:.4f}  "
              f"ratio=1/c={1/_C_CONST:.4f}")
        print(f"\n{'variant':>11} {'neg events':>11} {'pos events':>11} "
              f"{'neg/symbol-day':>15} {'neg/pooled-bar':>15} {'neg share':>10}")
        for kk in ("shipped", "corrected"):
            neg, pos = tot[kk]
            print(f"{kk:>11} {neg:>11,} {pos:>11,} {neg/tot_symdays:>15.4f} "
                  f"{neg/tot_bars:>15.5f} {neg/max(neg+pos,1):>10.4f}")
        d_ship = tot['shipped'][0] / tot_symdays
        d_corr = tot['corrected'][0] / tot_symdays
        print(f"\nSPEC FR10[v4] records 0.087 neg events/symbol-day.")
        print(f"  shipped   = {d_ship:.4f}  -> ratio to SPEC = {d_ship/0.087:.3f}")
        print(f"  corrected = {d_corr:.4f}  -> ratio to SPEC = {d_corr/0.087:.3f}")
        print(f"  corrected/shipped uplift = {d_corr/max(d_ship,1e-12):.3f}x")
        print(f"  shortfall vs CT-3 floor 1.0/symbol-day:"
              f"  shipped {1/max(d_ship,1e-12):.1f}x   corrected {1/max(d_corr,1e-12):.1f}x")
        per_sym.sort(key=lambda r: -r[2] / max(r[1], 1))
        print(f"\ntop 8 symbols by shipped neg-jumps/symbol-day:")
        print(f"{'symbol':>14} {'symdays':>8} {'shipped/d':>10} {'corrected/d':>12}")
        for s, d, a, b in per_sym[:8]:
            print(f"{s:>14} {d:>8} {a/d:>10.4f} {b/d:>12.4f}")
        print(f"\nbottom 4:")
        for s, d, a, b in per_sym[-4:]:
            print(f"{s:>14} {d:>8} {a/d:>10.4f} {b/d:>12.4f}")
        mx = max(r[2] / max(r[1], 1) for r in per_sym)
        print(f"\nBEST single symbol, shipped:   {mx:.4f} neg/day  "
              f"({1/max(mx,1e-12):.1f}x below the 1.0 floor)")
        mx2 = max(r[3] / max(r[1], 1) for r in per_sym)
        print(f"BEST single symbol, corrected: {mx2:.4f} neg/day  "
              f"({1/max(mx2,1e-12):.1f}x below the 1.0 floor)")
    finally:
        await pool.close()

asyncio.run(main())

