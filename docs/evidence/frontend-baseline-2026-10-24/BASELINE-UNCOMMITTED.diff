+    def test_two_different_devanagari_names_differ(self):
+        assert _norm(UTTAR_PRADESH) != _norm(TAMIL_NADU)
+
+    @pytest.mark.parametrize("name,expected", [
+        ("NTPC Ltd", "ntpc"),
+        ("NTPC", "ntpc"),
+        ("Reliance Industries Limited", "reliance industries"),
+        ("Tata Steel", "tata steel"),
