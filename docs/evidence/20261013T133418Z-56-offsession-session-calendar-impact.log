APPENDIX A - offsession_impact.py, verbatim

================================================================================
"""D-4: does the off-session / short-session bar population affect any pillar
output used in evaluation?

Answers, read-only (SELECT only):
  1. which dates carry off-session or short intraday sessions
  2. whether those dates also exist as DAILY observations in daily_prices,
     rmt_output, hamilton_output (they are real trading days, so they should)
  3. whether any of them falls inside an FR32 crisis window (break + 30 trading
     days) or lead window (5-15 trading days before the break)
  4. which hawkes_output / csrs rows sit on such a date
"""
import asyncio
import sys

import asyncpg

sys.path.insert(0, r"C:\Users\Arlop\Downloads\SERAPH VARYA\SERAPH Varya")
from seraph.store.bootstrap import resolve_dsn                      # noqa: E402
from seraph.validation.epochs import (                              # noqa: E402
    CRISIS_WINDOW_DAYS, EPOCH_BREAKS, LEAD_WINDOW_DAYS,
)

# the five non-standard hawkes_output emission dates found in the -54- log
HAWKES_ODD = ["2020-04-27", "2024-03-02", "2024-05-18", "2024-11-01",
              "2025-10-21"]


async def main():
    pool = await asyncpg.create_pool(resolve_dsn(), min_size=1, max_size=2)
    try:
        # ---- 1. off-session + short-session intraday dates ------------------
        off = [r["d"] for r in await pool.fetch("""
            SELECT DISTINCT (ts AT TIME ZONE 'Asia/Kolkata')::date AS d
            FROM intraday_bars
            WHERE (ts AT TIME ZONE 'Asia/Kolkata')::time < '09:15'::time
               OR (ts AT TIME ZONE 'Asia/Kolkata')::time > '15:30'::time
            ORDER BY 1""")]
        short = [(r["d"], r["k"]) for r in await pool.fetch("""
            SELECT d, k FROM (
              SELECT (ts AT TIME ZONE 'Asia/Kolkata')::date AS d,
                     count(DISTINCT (ts AT TIME ZONE 'Asia/Kolkata')::time) AS k
              FROM intraday_bars GROUP BY 1) s
            WHERE k < 70 ORDER BY d""")]
        print(f"off-session dates                 : {len(off)}")
        print(f"short sessions (<70 bar-times)    : {len(short)}")
        suspect = sorted({*off, *[d for d, _ in short]})
        print(f"union of non-standard session dates: {len(suspect)}")
        kmap = dict(short)
        for d in suspect:
            print(f"    {d}  bar-times={kmap.get(d, 75):>3}"
                  f"  off_session={'yes' if d in off else 'no'}")

        # ---- 2. the NSE trading calendar, from daily_prices -----------------
        cal = [r["date"] for r in await pool.fetch(
            "SELECT DISTINCT date FROM daily_prices ORDER BY date")]
        cal_idx = {d: i for i, d in enumerate(cal)}
        print(f"\ndaily_prices trading calendar     : {len(cal)} sessions "
              f"{cal[0]} .. {cal[-1]}")

        print("\n--- are these real trading days in the DAILY pillars? -------")
        for d in suspect:
            dp = await pool.fetchval(
                "SELECT count(*) FROM daily_prices WHERE date=$1", d)
            rm = await pool.fetchval(
                "SELECT count(*) FROM rmt_output WHERE date=$1", d)
            hm = await pool.fetchval(
                "SELECT count(*) FROM hamilton_output WHERE date=$1", d)
            print(f"    {d}  daily_prices={dp:>4}  rmt_output={rm}  "
                  f"hamilton_output={hm}")

        # ---- 3. FR32 window membership --------------------------------------
        print("\n--- FR32 windows (break + 30 trading days; lead 5-15 before) ")
        windows = {}
        for ep, (bd, _) in EPOCH_BREAKS.items():
            import datetime as _dt
            b = _dt.date.fromisoformat(bd)
            # first calendar session on/after the break
            i = next((j for j, d in enumerate(cal) if d >= b), None)
            if i is None:
                print(f"    {ep:>16} break {bd}: beyond the calendar")
                continue
            crisis = cal[i: i + CRISIS_WINDOW_DAYS + 1]
            lo, hi = LEAD_WINDOW_DAYS
            lead = cal[max(0, i - hi): max(0, i - lo) + 1]
            windows[ep] = (set(crisis), set(lead))
            print(f"    {ep:>16} break {bd} -> crisis {crisis[0]}..{crisis[-1]}"
                  f"   lead {lead[0] if lead else '-'}..{lead[-1] if lead else '-'}")

        print("\n--- does any non-standard session date land in a window? ----")
        hits = 0
        for d in suspect:
            where = [f"{ep}:CRISIS" for ep, (c, _) in windows.items() if d in c]
            where += [f"{ep}:LEAD" for ep, (_, l) in windows.items() if d in l]
            if where:
                hits += 1
            print(f"    {d}  {'  '.join(where) if where else 'outside every window'}")
        print(f"  -> {hits} of {len(suspect)} non-standard session dates fall "
              f"in an FR32 crisis or lead window")

        # ---- 4. the 5 odd hawkes_output rows --------------------------------
        print("\n--- the 5 non-standard hawkes_output emission dates ---------")
        for ds in HAWKES_ODD:
            import datetime as _dt
            d = _dt.date.fromisoformat(ds)
            where = [f"{ep}:CRISIS" for ep, (c, _) in windows.items() if d in c]
            where += [f"{ep}:LEAD" for ep, (_, l) in windows.items() if d in l]
            n_csrs = await pool.fetchval(
                "SELECT count(*) FROM csrs WHERE (ts AT TIME ZONE "
                "'Asia/Kolkata')::date = $1", d)
            print(f"    {ds}  csrs_rows={n_csrs}  "
                  f"{'  '.join(where) if where else 'outside every FR32 window'}")

        # ---- 5. how many csrs rows sit on a non-standard session date -------
        n = await pool.fetchval("""
            SELECT count(*) FROM csrs c WHERE (c.ts AT TIME ZONE
              'Asia/Kolkata')::date IN (
                SELECT DISTINCT (ts AT TIME ZONE 'Asia/Kolkata')::date
                FROM intraday_bars
                WHERE (ts AT TIME ZONE 'Asia/Kolkata')::time < '09:15'::time
                   OR (ts AT TIME ZONE 'Asia/Kolkata')::time > '15:30'::time)""")
        tot = await pool.fetchval("SELECT count(*) FROM csrs")
        print(f"\ncsrs rows on an OFF-SESSION date  : {n} / {tot}")
    finally:
        await pool.close()

asyncio.run(main())

