import asyncio, sys, datetime as dt
import asyncpg
sys.path.insert(0, r"C:\Users\Arlop\Downloads\SERAPH VARYA\SERAPH Varya")
from seraph.store.bootstrap import resolve_dsn

D = [dt.date.fromisoformat(s) for s in
     ["2015-11-11","2016-10-30","2017-07-10","2017-10-19","2018-11-07",
      "2019-10-27","2020-03-13","2020-03-23","2020-11-14","2021-02-24",
      "2021-11-04","2022-10-24","2023-11-12","2024-03-02","2024-05-18",
      "2024-11-01","2025-10-21"]]

async def main():
    p = await asyncpg.create_pool(resolve_dsn(), min_size=1, max_size=2)
    try:
        print(f"{'date':>12} {'wd':>4} {'bars':>8} {'syms':>5}  {'IST window':>21} {'daily_px':>9}")
        for d in D:
            r = await p.fetchrow("""
                SELECT count(*) n, count(DISTINCT symbol) s,
                       min((ts AT TIME ZONE 'Asia/Kolkata')::time) lo,
                       max((ts AT TIME ZONE 'Asia/Kolkata')::time) hi
                FROM intraday_bars
                WHERE (ts AT TIME ZONE 'Asia/Kolkata')::date = $1""", d)
            dp = await p.fetchval("SELECT count(*) FROM daily_prices WHERE date=$1", d)
            print(f"{d} {d.strftime('%a'):>4} {r['n']:>8} {r['s']:>5}  {r['lo']}..{r['hi']} {dp:>9}")
        print("\n--- 2021-02-24: post-close bars, by symbol ---")
        for r in await p.fetch("""
            SELECT symbol, count(*) n,
                   min((ts AT TIME ZONE 'Asia/Kolkata')::time) lo,
                   max((ts AT TIME ZONE 'Asia/Kolkata')::time) hi
            FROM intraday_bars
            WHERE (ts AT TIME ZONE 'Asia/Kolkata')::date=$1
              AND (ts AT TIME ZONE 'Asia/Kolkata')::time > '15:30'
            GROUP BY 1 ORDER BY 1""", dt.date(2021,2,24)):
            print(f"    {r['symbol']:>14} bars={r['n']:>3}  {r['lo']}..{r['hi']}")
        print("\n--- 2020-03-13 / 2020-03-23: missing bar-times (circuit breaker?) ---")
        full = sorted({f"{h:02d}:{m:02d}:00" for h in range(9,16)
                       for m in range(0,60,5) if (9,15) <= (h,m) <= (15,30)})
        for d in (dt.date(2020,3,13), dt.date(2020,3,23)):
            have = {str(r['t']) for r in await p.fetch("""
                SELECT DISTINCT (ts AT TIME ZONE 'Asia/Kolkata')::time t
                FROM intraday_bars WHERE (ts AT TIME ZONE 'Asia/Kolkata')::date=$1""", d)}
            miss = sorted(set(full) - have)
            print(f"    {d}: {len(have)}/{len(full)} present; missing {len(miss)}"
                  + (f" -> {miss[0]} .. {miss[-1]} (contiguous={len(miss)==1+full.index(miss[-1])-full.index(miss[0])})" if miss else ""))
    finally:
        await p.close()
asyncio.run(main())
